# bash/sh: source env/run_date.env
# Sets dated designmat/results folder names when not already defined.
if [ "${BMI_IMAGING_AUTO_RUN_DATE:-1}" = "1" ] || [ "${BMI_IMAGING_AUTO_RUN_DATE}" = "true" ]; then
  : "${BMI_IMAGING_RUN_TAG:=$(date +%Y_%m_%d)}"
  if [ -z "${BMI_IMAGING_DESIGNMATS_DIR:-}" ] && [ -z "${BMI_IMAGING_DESIGNMATS_SUBDIR:-}" ]; then
    export BMI_IMAGING_DESIGNMATS_SUBDIR="designmats_${BMI_IMAGING_RUN_TAG}"
  fi
  if [ -z "${BMI_IMAGING_RESULTS_RUN:-}" ]; then
    export BMI_IMAGING_RESULTS_RUN="results_${BMI_IMAGING_RUN_TAG}"
  fi
  export BMI_IMAGING_RUN_TAG
fi
