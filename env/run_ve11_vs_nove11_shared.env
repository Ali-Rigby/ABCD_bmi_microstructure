# bash/sh: source env/run_ve11_vs_nove11_shared.env
# Shared tables for VE11 vs noVE11 matched sensitivity analysis (6.0 imaging).
# Prerequisite: main-pipeline s1 has written
#   $CEPH/shared/datafiles/datafile6.0_before_bfs_anthroqc_bmip_agediscrepancy_dmri_incl.txt
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/run_shared.env"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/run_date.env"

export BMI_VE11_NOVE11_ANALYSIS_ROOT="${BMI_VE11_NOVE11_ANALYSIS_ROOT:-ve11_vs_noVE11_6_0}"
export BMI_IMAGING_SHARED_DATAFILES_DIR="${BMI_VE11_NOVE11_ANALYSIS_ROOT}/shared/datafiles"

export BMI_MATCH_PERC_MEDIAN_CALIPER="${BMI_MATCH_PERC_MEDIAN_CALIPER:-10}"
export BMI_MATCH_AGE_CALIPER="${BMI_MATCH_AGE_CALIPER:-0.25}"
export BMI_VE11_SOFTWARE_PATTERN="${BMI_VE11_SOFTWARE_PATTERN:-syngo[ _]MR[ _]E11}"
export BMI_VE11_NOVE11_MATCH_INPUT_BASE="${BMI_VE11_NOVE11_MATCH_INPUT_BASE:-datafile6.0_before_bfs_anthroqc_bmip_agediscrepancy_dmri_incl.txt}"

export BMI_IMAGING_ABCD_SYNC="${BMI_IMAGING_ABCD_SYNC:-/space/ceph/1/ABCD/users/parekh/2025-11-19_ABCD_concat_uncompressed/6_0}"
unset BMI_IMAGING_VOXELWISE_RSI_DIR

echo "VE11 vs noVE11 shared profile:"
echo "  BMI_IMAGING_REPO_ROOT=${BMI_IMAGING_REPO_ROOT}"
echo "  BMI_VE11_NOVE11_ANALYSIS_ROOT=${BMI_VE11_NOVE11_ANALYSIS_ROOT}"
echo "  BMI_IMAGING_SHARED_DATAFILES_DIR=${BMI_IMAGING_SHARED_DATAFILES_DIR}"
echo "  BMI_IMAGING_ABCD_SYNC=${BMI_IMAGING_ABCD_SYNC}"
