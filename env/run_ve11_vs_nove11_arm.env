# bash/sh: source env/run_ve11_vs_nove11_arm.env
# Per-arm FEMA profile (s5–s9).
# Required:
#   export BMI_PHENO_VARIABLE=bmip|perc_median
#   export BMI_SCANNER_ARM=VE11|noVE11
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_bmi_pheno_save="${BMI_PHENO_VARIABLE:-}"
_bmi_arm_save="${BMI_SCANNER_ARM:-}"
_bmi_base_imaging_save="${BMI_IMAGING_BASE_DATAFILE_IMAGING:-}"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/run_ve11_vs_nove11_shared.env"
[[ -n "${_bmi_pheno_save}" ]] && export BMI_PHENO_VARIABLE="${_bmi_pheno_save}"
[[ -n "${_bmi_arm_save}" ]] && export BMI_SCANNER_ARM="${_bmi_arm_save}"
[[ -n "${_bmi_base_imaging_save}" ]] && export BMI_IMAGING_BASE_DATAFILE_IMAGING="${_bmi_base_imaging_save}"
unset _bmi_pheno_save _bmi_arm_save _bmi_base_imaging_save

: "${BMI_PHENO_VARIABLE:?Set BMI_PHENO_VARIABLE to bmip or perc_median}"
: "${BMI_SCANNER_ARM:?Set BMI_SCANNER_ARM to VE11 or noVE11}"

case "${BMI_SCANNER_ARM}" in
  VE11|noVE11) ;;
  *) echo "BMI_SCANNER_ARM must be VE11 or noVE11" >&2; exit 1 ;;
esac

export BMI_IMAGING_BASE_DATAFILE_IMAGING="${BMI_IMAGING_BASE_DATAFILE_IMAGING:-datafile_matched_combined.txt}"
export BMI_IMAGING_ANALYSIS_DIR="${BMI_VE11_NOVE11_ANALYSIS_ROOT}/${BMI_PHENO_VARIABLE}/${BMI_SCANNER_ARM}"
export BMI_IMAGING_DATAFILES_DIR="${BMI_VE11_NOVE11_ANALYSIS_ROOT}/${BMI_PHENO_VARIABLE}/datafiles"

case "${BMI_PHENO_VARIABLE}" in
  bmip)
    export BMI_IMAGING_MERGED_DATAFILE=datafile_matched_with_bmi_age_pds_bfs.txt
    ;;
  perc_median)
    export BMI_IMAGING_MERGED_DATAFILE=datafile_matched_with_perc_median_age_pds_bfs.txt
    export BMI_IMAGING_PHENO_GRID_STEP="${BMI_IMAGING_PHENO_GRID_STEP:-1}"
    ;;
  *)
    echo "BMI_PHENO_VARIABLE must be bmip or perc_median" >&2
    exit 1
    ;;
esac

export BMI_SCANSOFT_MODAL_REF="${BMI_SCANSOFT_MODAL_REF:-1}"
export BMI_SCANNER_SERIAL_MODAL_REF="${BMI_SCANNER_SERIAL_MODAL_REF:-1}"

echo "VE11 vs noVE11 arm profile:"
echo "  BMI_PHENO_VARIABLE=${BMI_PHENO_VARIABLE}"
echo "  BMI_SCANNER_ARM=${BMI_SCANNER_ARM}"
echo "  BMI_IMAGING_ANALYSIS_DIR=${BMI_IMAGING_ANALYSIS_DIR}"
